# ==============================================================================
# FastAPI / Python Standard GitIgnore Template
# ==============================================================================

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Standard FastAPI setups)
.venv/
venv/
ENV/
env/
env3/
__pypackages__/

# FastAPI Configuration & Environment Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env

# Pipenv / Poetry / PDM package managers
# Note: It is recommended to commit Poetry/Pipenv lock files, but ignore caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.uv/

# Testing & Coverage reports
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
log.txt

# Logging
*.log
logs/

# Databases (Common for local FastAPI development)
*.db
*.sqlite3
*.sqlite

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

*.zip